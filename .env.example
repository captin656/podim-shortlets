# ───────────── Core ─────────────
# Public URL of the site (no trailing slash). On Vercel set this to your production domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL connection string (Neon, Supabase, Railway, Vercel Postgres, or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/podium?schema=public"

# ───────────── Auth (NextAuth) ─────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google login (optional — the button hides itself when these are empty)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ───────────── Paystack ─────────────
# Dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
# Webhook URL to register in Paystack: https://YOUR-DOMAIN/api/paystack/webhook

# ───────────── Email (SMTP) ─────────────
# Works with Resend SMTP, Zoho, Gmail app password, Mailgun, etc.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASSWORD=""
EMAIL_FROM="Podium Apartments <stay@podiumapartments.ng>"

# ───────────── SMS / OTP (Termii) ─────────────
TERMII_API_KEY=""
TERMII_SENDER_ID="Podium"

# ───────────── Contact & WhatsApp ─────────────
# International format, digits only, no plus sign. Replace with the real number.
NEXT_PUBLIC_WHATSAPP_NUMBER="2348000000000"
NEXT_PUBLIC_PHONE_DISPLAY="+234 800 000 0000"
CONTACT_INBOX_EMAIL="stay@podiumapartments.ng"

# ───────────── Maps ─────────────
# Optional. Maps work without a key through the embed; add a key for the Maps Embed API.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# ───────────── File uploads ─────────────
# Vercel Blob (project → Storage → Blob). Used for apartment photos and bank-transfer proof.
BLOB_READ_WRITE_TOKEN=""

# ───────────── Cron ─────────────
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/* routes.
CRON_SECRET="replace-with-another-random-string"

# ───────────── Seed ─────────────
# Credentials for the first admin created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@podiumapartments.ng"
SEED_ADMIN_PASSWORD="ChangeMe-Now-123"
